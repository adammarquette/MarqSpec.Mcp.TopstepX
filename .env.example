# .env.example — the configuration catalogue.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not. THIS REPOSITORY IS PUBLIC — never put a
# real credential in a tracked file, and note that the sibling ProjectX client has already leaked and rotated
# one once.
#
# Every key here must be forwarded by docker-compose.yml's `environment:` block, and every key that block
# forwards must be documented here. A key documented but not forwarded is a setting that silently does nothing
# in a container.
#
# Nesting uses `__` (double underscore), which is how .NET's environment-variable configuration provider maps
# to a section path: `ProjectX__ApiKey` binds to the `ProjectX` section's `ApiKey`.


# ─────────────────────────────────────────────────────────────────────────────
# ProjectX / TopstepX gateway
# ─────────────────────────────────────────────────────────────────────────────

# READ THIS BEFORE FILLING THE NEXT TWO IN. The names are inverted from what they read like.
#
#   ProjectX__ApiKey     ->  your TopstepX USERNAME   (sent as "username")
#   ProjectX__ApiSecret  ->  your API KEY             (sent as "apikey")
#
# The endpoint is "log in as the specified user using the specified API key". Putting the API key in BOTH
# fields authenticates as a user who does not exist, and fails with a bare "Authentication failed: Unknown
# error" -- delivered as an HTTP 200 carrying success=false, with no reason given. There is nothing in that
# response to suggest the username is the problem.
ProjectX__ApiKey=
ProjectX__ApiSecret=

# REQUIRED in the application. Simulated | Live
#
# This selects which market-data universe answers a contract search or a bar request. It is a DATA
# ENTITLEMENT axis, not an account one.
#
# The wrong tier returns an EMPTY RESULT, NOT AN ERROR. Measured with practice credentials: a search for "ES"
# returns 6 contracts on Simulated and 0 on Live; available-contracts returns 51 and 0. Nothing 4xxs. The
# failure surfaces far away as "no contract matches ES", so the application never defaults this and startup
# fails if it is unset when credentials are set (R-7.2).
#
# The compose stack is the one exception, and it is the same local convenience as Mcp__HttpBearerToken
# below: docker-compose.yml forwards ProjectX__DataTier:-Simulated so `docker compose up` with credentials
# and no tier does not fail startup. This file still names the value explicitly. Dropping the compose
# default would make an otherwise-working local stack refuse to boot.
ProjectX__DataTier=Simulated

# Firm-branded hosts. Another ProjectX-family firm runs different hostnames.
ProjectX__BaseUrl=https://api.topstepx.com


# ─────────────────────────────────────────────────────────────────────────────
# Database — one Postgres, both extensions (ADR-0004)
# ─────────────────────────────────────────────────────────────────────────────

# The compose stack runs timescale/timescaledb-ha:pg17, which bundles timescaledb AND pgvector. Migrations
# probe for each and degrade rather than fail, so a plain postgres:17 also works -- the bar table is simply
# not a hypertable. That is a performance property here, not a correctness one.
POSTGRES_USER=topstepx

# Leaving this at the compose default is fine for local development -- the same posture as
# Mcp__HttpBearerToken below -- and it is acceptable ONLY because compose binds 5432 to 127.0.0.1; the two
# travel together, and publishing the port wider means setting a real password in the same change (gh#421).
#
# The asymmetry with the bearer token: that token authenticates nothing at the venue and has never had a
# value worth rotating, while this credential OWNS THE SCHEMA -- it can read, write or drop the bar cache,
# the trade tape, coverage ledgers and indicator projections. Loopback is the whole of what makes it
# tolerable, not the value itself.
POSTGRES_PASSWORD=changeme-local
POSTGRES_DB=topstepx_mcp

ConnectionStrings__Default=Host=postgres;Port=5432;Database=topstepx_mcp;Username=topstepx;Password=changeme-local


# ─────────────────────────────────────────────────────────────────────────────
# MCP transport (ADR-0007)
# ─────────────────────────────────────────────────────────────────────────────

# Stdio | Http
#
# Stdio is the default and is what an MCP client launches locally. In that mode ALL logging goes to stderr:
# anything written to stdout corrupts the protocol frame, and it fails as an opaque handshake error that
# points nowhere near logging.
Mcp__Transport=Stdio

# Required when Transport=Http, ignored otherwise, and startup FAILS without one. An unauthenticated MCP
# endpoint carrying balances, positions and trade history is a data leak even though nothing here can trade.
#
# Leaving this blank is fine for the compose stack, which defaults it to changeme-local so `docker compose up`
# works out of the box -- the same posture as POSTGRES_PASSWORD. That default is acceptable only because
# compose binds the port to 127.0.0.1; the two travel together. Publishing it wider means setting a real
# value in the same change. This used to read as though loopback were already the case, while the mapping
# published to every interface (gh#415).
#
# TLS DOES NOT REPLACE THIS. The composed endpoint is HTTPS since gh#416, and that is confidentiality on the
# wire; the token is authorisation, and it is still required and still enforced at request time.
Mcp__HttpBearerToken=


# ─────────────────────────────────────────────────────────────────────────────
# TLS on the composed endpoint (ADR-0007, gh#416)
# ─────────────────────────────────────────────────────────────────────────────

# THE ONLY VARIABLE IN THIS FILE WITH NO COMPOSE DEFAULT, and that is deliberate: it unlocks a private key.
# POSTGRES_PASSWORD and Mcp__HttpBearerToken carry local defaults because a loopback port is what they guard;
# a default that decrypts a key is not the same kind of thing, and THIS REPOSITORY IS PUBLIC. docker-compose.yml
# uses `${...:?}`, so an unset value stops compose with a message rather than falling back to anything.
#
# Set it to a value you generate. Never commit it; `.env` is gitignored and this file documents the VARIABLE.
#
#   openssl rand -hex 24
#
# HEX, NOT BASE64, IF YOU ARE IN GIT BASH. MSYS rewrites an argument containing `/` into a Windows path, so a
# base64 password reaches `openssl`/`dotnet` mangled -- and the failure arrives much later and points the
# wrong way, as `The certificate data cannot be read with the provided password, the password may be
# incorrect` from inside the container. Hex has no `/`.
#
# THE CERTIFICATE. The maintainer scoped this to a client on the SAME MACHINE, so it needs a LOCALLY TRUSTED
# certificate, not a publicly issued one -- no Let's Encrypt, no tunnel, no public hostname. A genuinely
# remote instance is a different operational story and is not settled here. Use mkcert:
#
#   winget install FiloSottile.mkcert                  # or `brew install mkcert`; see README.md
#
#   mkcert -install                                    # once per host, and READ THE NEXT LINE FIRST
#   mkcert -cert-file ./certs/localhost.crt -key-file ./certs/localhost.key localhost 127.0.0.1 ::1
#   openssl pkcs12 -export -out ./certs/localhost.pfx \
#     -inkey ./certs/localhost.key -in ./certs/localhost.crt \
#     -certfile "$(mkcert -CAROOT)/rootCA.pem" -passout "pass:<the value you set below>"
#   rm ./certs/localhost.key                           # the PFX carries the key, encrypted
#
# `mkcert -install` WRITES A NEW ROOT CA INTO YOUR OS TRUST STORE. That is a real change to the machine,
# not a project-local file: until it is undone, anything that CA signs is trusted by every application that
# reads that store. `mkcert -uninstall` removes it again, and `mkcert -CAROOT` prints where the key lives --
# guard that directory, because it can mint a certificate for any name.
#
# `dotnet dev-certs` looks like the cheaper answer and does not work for every client. That certificate is a
# self-signed LEAF (`basicConstraints: CA:FALSE`), which OpenSSL cannot anchor on, so an OpenSSL-based client
# refuses it -- and no client-side setting rescues it. ADR-0007's 2026-09-01 TLS update has the measurements.
#
# NOTHING ROTATES THIS. mkcert's leaf is good for about two years; re-issue past its expiry.
Kestrel__Certificates__Default__Password=


# ─────────────────────────────────────────────────────────────────────────────
# Market data — sessions, instruments, caps
#
# There is no resolution setting, and that is deliberate: resolution is a per-call parameter and every
# whole number of minutes from 1 to 10,080 is servable (ADR-0010, R-1.9). This heading said
# "resolutions" until gh#48, which read as a setting someone had forgotten to add.
# ─────────────────────────────────────────────────────────────────────────────

# The session close in Central WALL-CLOCK time, HH:mm. 16:00 is CME equity index.
#
# This value decides what counts as missing data. Set it an hour late and the last hour of every day looks
# like a permanent gap that is re-fetched forever; set it early and real bars are never requested. Parsing
# refuses a malformed value rather than guessing (ADR-0005).
MarketData__SessionCloseCentral=16:00

# Comma-separated yyyy-MM-dd. An undeclared holiday is re-requested all day -- a bounded, visible cost, and
# the safe direction for this to be wrong in.
MarketData__Holidays=

# The largest number of rows a single windowed read will return. Over this, the read REFUSES and reports the
# real count. It never truncates: a silently shortened series is a chart with the interesting part cut off.
MarketData__MaxRows=5000

# Comma-separated instrument symbols this server will serve. The shipped default is ES,NQ -- the same
# values MarketDataOptions and compose use. An unlisted symbol is an error that names these, rather
# than an empty series -- a wrong symbol and a quiet market must not look identical.
#
# InstrumentRegistry also knows YM, CL, GC, SI, MES, MNQ, MCL, MGC and a few more; listing one that
# is not in that table fails startup. Copying this file used to enable the longer list, which changed
# the served universe from the catalogue default.
MarketData__Instruments=ES,NQ

# Subscribe to the market hub and write prints to Trades. OFF by default.
#
# HTTP is not consent: the recorder starts only when the transport is Http AND this switch is on
# (ADR-0016). Two subscribers on one tape double every volume, and a doubled delta looks like
# order flow. Leave this off on any process that is not the single long-lived HTTP instance
# meant to hold the subscription — including a Cowork stdio child against the same store.
MarketData__RecordTape=false

# Replay stored indicator series at process start. OFF by default.
#
# HTTP is not consent: warmup runs only when the transport is Http AND this switch is on
# (ADR-0014, gh#350). Same shape as RecordTape. Leave this off on stdio — a Cowork child
# against a large store would stall the handshake paying the first-read projection
# (~8.3 s for a year of five-minute bars). A failure is logged; the host keeps serving.
MarketData__WarmIndicators=false


# ─────────────────────────────────────────────────────────────────────────────
# Indicators (ADR-0006)
# ─────────────────────────────────────────────────────────────────────────────

# Periods only. MACD's fast/signal lengths (12/9) and Bollinger's width (2 sigma) are deliberately NOT
# configurable: the storage key is (Indicator, Period), and a parameter the key cannot see would let two
# parameterisations be written under one key and become indistinguishable once stored.
Indicators__AtrPeriod=14
Indicators__RsiPeriod=14
Indicators__SmaPeriod=20
Indicators__EmaPeriod=20
Indicators__MacdSlowPeriod=26
Indicators__BollingerPeriod=20


# ─────────────────────────────────────────────────────────────────────────────
# Key-level detection (ADR-0013)
# ─────────────────────────────────────────────────────────────────────────────

# THE OPPOSITE OF THE BLOCK ABOVE, and deliberately. Indicator parameters are fixed because their storage key
# is (Indicator, Period) and a parameter the key cannot see makes two parameterisations indistinguishable
# once written. Levels are computed on every read and NOTHING stores one -- there is no level table at all
# since gh#276 dropped the empty one -- so there is no key for a parameter to fall out of, which is what lets
# these be settable at all and what lets two of them be per-call arguments on get_key_levels. ADR-0013 records
# that decision and names the condition that reverses it: the moment anything stores a level.

# Which price on a bar a pivot is measured from: HeikinAshiBody, Body or HighLow. Overridable per call as
# get_key_levels' pivotSource.
#
# Heikin-Ashi smooths single-bar noise into structure, which is why it is the default. An unset or mistyped
# value binds to Unknown = 0, and STARTUP FAILS on it rather than picking a price series by accident -- the
# detection reads anything it does not recognise as Heikin-Ashi, so a wrong value here would produce
# ordinary-looking levels measured from a source nobody chose.
KeyLevels__Source=HeikinAshiBody

# How many bars to its LEFT a pivot must dominate; larger means fewer, more structural levels. Overridable
# per call as get_key_levels' pivotLookback.
#
# Detection needs this + PivotRightLookback + 1 bars to find even one pivot, and it runs over what the STORE
# holds cut back to the contract in front -- so a large value here yields an EMPTY level set rather than an
# error. That is deliberate: get_market_snapshot detects over a fixed max(barCount, 200) window and exposes
# neither knob, so refusing would be an error naming arguments its caller does not have. The level set
# reports the detection it ran under, so the emptiness is readable rather than mistakable for a market with
# no structure.
KeyLevels__PivotLookback=20

# How many bars to its RIGHT a pivot must dominate -- the confirmation window. Overridable per call as
# get_key_levels' pivotRightLookback.
#
# Shorter than the left one because the two sides answer different questions: the left is how much history
# the extreme stood clear of, the right only has to show that it held. It is also the LAG -- the last
# this-many bars of any series can never produce a pivot, so the newest structure is always missing from the
# answer. Zero is refused at startup: a pivot judged only by the bars before it repaints as soon as the next
# one arrives (R-3.4).
KeyLevels__PivotRightLookback=15

# A zone's full width, in ATR multiples. NOT overridable per call: the width is what makes "the same level"
# mean the same thing to two readers, and it is the tolerance the confluence score reports and clusters on.
KeyLevels__ZoneAtrMultiple=0.5

# The smallest prominence, in ATR multiples, worth reporting. NOT overridable per call, and this is the one
# that most needed saying no to: turn it down and a wall of insignificant pivots arrives looking like
# structure; turn it up and an empty level set arrives looking like a market that has none. On the 10,000-bar
# series ADR-0013 measured, 0.25 produced 154 zones and 1.5 produced none, against 56 here.
KeyLevels__MinSignificance=0.5

# The widest a reported zone may be, as a percentage of its own midpoint price. A wider one is DROPPED, not
# narrowed. NOT overridable per call.
#
# A backstop on the merge rather than a calibration knob. Every zone entering the merge is exactly
# ZoneAtrMultiple x ATR wide, so the merge is the only stage that can widen one without limit -- and since
# ADR-0015 it merges across supports and resistances alike, so a chain that used to stop at a polarity change
# now runs through it. Deliberately loose: 2.5% of ES at 5,000 is a 125-point band, wider than most whole
# sessions. Tighten it and it starts deleting ordinary structure, silently.
KeyLevels__MaxZoneWidthPercent=2.5

# The most levels one detection may report, most significant first. The rest are ABSENT, not summarised, and
# `detection.maxLevels` is reported beside the answer so a list of exactly this length can be told from a
# complete one. NOT overridable per call.
#
# It bounds what an agent is handed, not what detection costs -- ADR-0013 measured 0.51 ms over the tool's
# 500-bar window at a lookback of 20, and 44 zones over 10,000 bars there. (Its headline 0.21 ms and 56 zones
# are the figures for a lookback of 5, the shipped value when that record was written.) Zero is refused at
# startup: it would empty every level set, and an empty one reads as a market with no structure.
KeyLevels__MaxLevels=12

# Per-method confluence weights. An unlisted method weighs 1. Do NOT encode the family discount here as
# five 0.2s — the five pivot-* methods share one budget because they declare one family, and a list of
# names is what the sixth variant silently escapes. Leave them at 1.
KeyLevels__Weights__swing=1
KeyLevels__Weights__session=1
KeyLevels__Weights__pivot-classic=1
KeyLevels__Weights__pivot-fibonacci=1
KeyLevels__Weights__pivot-camarilla=1
KeyLevels__Weights__pivot-woodie=1
KeyLevels__Weights__pivot-demark=1


# ─────────────────────────────────────────────────────────────────────────────
# Observations (Phase 4)
# ─────────────────────────────────────────────────────────────────────────────

# Unset is a SUPPORTED STATE, not a broken one. Observation search falls back to substring matching, which is
# useful on its own, and the search result reports which mode answered so a caller is never left guessing
# whether an empty result means "nothing matched" or "semantic search never ran".
#
# AVAILABILITY MEANS A KEY *AND* SOMEWHERE TO PUT THE VECTOR. Both are checked once at startup: a deployment
# with a key but no `vector` extension would otherwise embed at real cost on every write and then fault at the
# upsert -- paying a vendor for vectors that cannot be stored, invisibly, until the bill arrives.
#
# Set this and observations are embedded as they are written, in the same transaction. Leave it unset and the
# server runs exactly as before -- record_observation still works, search_observations matches text and says so
# in `modeReason`. An unset key is a SUPPORTED STATE, not a fault.
#
# A rate limit or an outage does not fail the write either: the observation commits, and the tool result
# explains that it will match on text until re-embedded.
Embeddings__ApiKey=

# The Cohere model (ADR-0009). embed-v4.0 was chosen over embed-english-v3.0 for its 128k input context --
# v3 caps at 512 tokens, about 2,000 characters, which is a real ceiling on how long an observation can be.
#
# THE DIMENSION IS PINNED TO 1024 IN CODE, NOT HERE, AND THAT MATTERS. embed-v4.0 DEFAULTS TO 1536, and the
# database column is vector(1024) -- so every call must send output_dimension explicitly. Postgres rejects a
# 1536-wide value, so this fails loudly rather than silently, but only after the call has been paid for.
#
# Changing the MODEL is additive: Model is part of the Embeddings primary key, so re-embedding under a new one
# adds rows rather than overwriting and the old vectors survive. Changing the DIMENSION is not -- that is a
# migration plus a full re-embed, and every stored vector is discarded.
Embeddings__Model=embed-v4.0


# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────

ASPNETCORE_ENVIRONMENT=Development
Logging__LogLevel__Default=Information
