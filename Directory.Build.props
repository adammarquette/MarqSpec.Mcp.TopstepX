<Project>

  <!--
    Applies to every project in the repository. Project-specific settings (target frameworks,
    packaging metadata) stay in the .csproj.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      The PRD asks for analyzer warnings at zero (R-11.4). Nothing enforced it, so "at zero" was a
      hope. This is what makes it true.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>

    <!--
      Deterministic, source-linked builds. SourceLink ships in the SDK since .NET 8, so no
      PackageReference is needed — this library's dependency surface is part of its public contract
      (R-10.5) and is kept small on purpose.
    -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!--
      Restore fails on a package with a known HIGH/CRITICAL advisory rather than warning about it.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>high</NuGetAuditLevel>
  </PropertyGroup>

  <!--
    ADR-0001 — the git tag is the version. No file declares one; MinVer derives it from the nearest
    v-prefixed tag. This is why <Version> is absent from every .csproj.

    MinVer needs tag history: a shallow clone yields 0.0.0-alpha.0 SILENTLY rather than failing, so
    any CI job that packs needs `fetch-depth: 0`.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
