<Project>

  <!--
    Applies to every project in the repository. Project-specific settings stay in the .csproj.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Warnings are errors because this file says so, not because a requirement asks: the PRD numbers
      what the SERVER must do, and carries nothing about analyzer warnings. "At zero" is a hope until
      something enforces it — this is what makes it true. The requirement id this used to cite was
      another repository's, and never resolved here (gh#172).
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>

    <!--
      Deterministic, source-linked builds. SourceLink ships in the SDK since .NET 8, so no
      PackageReference is needed. Nothing compiles against this application's assemblies, so its
      dependency surface is not a public contract (gh#171); it is kept small because every package
      it takes ships inside the published image.
    -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!--
      Restore fails on a package with a known HIGH/CRITICAL advisory rather than warning about it.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>high</NuGetAuditLevel>
  </PropertyGroup>

  <!--
    ADR-0001 — the git tag is the version. No file declares one; MinVer derives it from the nearest
    v-prefixed tag. This is why <Version> is absent from every .csproj.

    MinVer needs tag history: a shallow clone yields 0.0.0-alpha.0 SILENTLY rather than failing.
    NOTHING HERE PACKS, so the rule is that every CI job which BUILDS ON THE RUNNER needs
    `fetch-depth: 0`. It does not reach the CONTAINER build, which never sees .git (see
    .dockerignore) and stamps 0.0.0-alpha.0 every time, at any depth.

    THAT IS READ OFF THE ARTIFACT, not inferred from a build log (gh#176): inside the published
    ghcr.io/adammarquette/marqspec.mcp.topstepx:0.1.0 image, MarqSpec.Mcp.TopstepX.dll carries
    AssemblyInformationalVersion 0.0.0-alpha.0 and AssemblyVersion 0.0.0.0. The release number is
    carried by the image TAG and by org.opencontainers.image.version instead, and the assembly's
    own stamp is decorative BY DECISION. ADR-0001's decision log has the reasoning and the cost.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
