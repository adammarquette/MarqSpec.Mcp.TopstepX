<Project>

  <!--
    Central Package Management — .csproj files carry no versions.

    This exists because they drift otherwise. In the repo this convention came from, the library pinned
    Microsoft.Extensions.* at 9.0.3 while two console apps pulled 10.0.0 of the same packages, which is how a
    downgrade warning appears the moment they compose.

    Adding a dependency needs a line in the PR saying why. This repository is an *application*, not a package,
    so its dependency surface is not a public contract — but it is still a supply-chain surface, and
    NuGetAudit is set to fail restore on a HIGH advisory rather than warn about one.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Build">
    <!-- Versioning from the git tag. Build-time only; never a runtime dependency. -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="MCP">
    <!--
      The official C# SDK. 2.2.0 is the current stable line; the 0.x previews are a different API shape, so a
      downgrade here is a rewrite, not a bump. .AspNetCore carries the streamable-HTTP transport (ADR-0007);
      the stdio transport lives in the core package.
    -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!--
      The OAuth 2.1 resource-server half of the HTTP transport (ADR-0007, ADR-0021, gh#512): validates a
      Cognito-issued JWT against the issuer's published keys, discovered from its OpenID configuration. Host
      only — it is a request-pipeline seam. 10.0.x to match the framework line the web host already pulls, for
      the same transitive-pinning reason as the Microsoft.Extensions.* packages below.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Venue">
    <!--
      The ProjectX/TopstepX gateway client, consumed as a package rather than a submodule (ADR-0003).

      3.0.0 is the first published major carrying Client#83 (nullable OrderSide on responses), #86 (hub
      contract id + honest trade direction) and #87 (re-subscribe). 2.1.0 was the first release this
      server could consume at all; the 1.0.x line predated the integer-enum serialization, Retry-After
      handling, and the startTimestamp rename that Order/Trade search silently requires (gh#13).
    -->
    <PackageVersion Include="MarqSpec.Client.ProjectX" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- pgvector: the CLR type plus its EF Core mapping. Both are needed; the type alone does not map. -->
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>

  <ItemGroup Label="Configuration, options, logging, hosting">
    <!--
      10.0.x, NOT 9.0.x. The web host pulls the 10.0 line transitively, and with transitive pinning on, a
      9.0 pin here is a downgrade error at restore rather than a warning at compose time.
    -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Telemetry">
    <!--
      OTLP is the telemetry boundary (ADR-0019). Referenced from the HOST ONLY: `Domain` references nothing
      and may read no clock, store or config singleton (ADR-0006), and an `ActivitySource` there would be all
      three at once; `Data` stores what it is handed. The instrumentation packages are subscriptions to
      sources that already exist — ASP.NET Core's, HttpClient's, the runtime's, Npgsql's and the MCP SDK's
      `Experimental.ModelContextProtocol` — so nothing here is a second telemetry system.

      One line pins the OpenTelemetry SDK and its exporter together on purpose: the exporter, the hosting
      extensions and the three instrumentation packages ship from one repository on one version train, and a
      mixed set is how a `TracerProviderBuilder` overload resolves against an SDK that does not have it.

      DELIBERATELY ABSENT: OpenTelemetry.Exporter.Console. There is no configuration under which writing
      telemetry to stdout is safe in this host — under stdio stdout IS the protocol frame (R-5.5) — so there
      is no flag and no package (ADR-0019, invariant 4).
    -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <!--
      Npgsql's own OpenTelemetry bridge, versioned with Npgsql rather than with the SDK above: it is the
      provider's package, and it tracks the driver it instruments.
    -->
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Test stack">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- LICENSE CAP: FluentAssertions v8+ is commercially licensed. Do not bump past 7.x. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- FakeTimeProvider. Session rules are wall-clock rules, so a test has to be able to stand
         at 15:58 on a Tuesday or at 03:00 on a Sunday exactly. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <!--
      MetricCollector, for the unit tier only. The same family and the same version as FakeTimeProvider above
      — they ship together, and a split version pair is a downgrade warning waiting for the next bump. It is
      what lets a test read the MEASUREMENT and its TAGS off an app-owned instrument (gh#536) rather than
      asserting that a method was called: an instrument nothing listens to records nothing, so the only honest
      test of one is a real listener over the real code path.
    -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.9.0" />
    <!--
      A real Postgres for the integration tier. The bar store's hypertable and the HNSW vector index are
      Timescale/pgvector features; an in-memory provider would pass a suite that proves nothing about them.
    -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!--
      For the unit tier only. The cache's central claim — that a repeated read costs ZERO vendor calls — is
      about logic, not SQL, so it is pinned by a fast in-memory test rather than only by a container the suite
      has to wait for. The schema-level claims (hypertable, HNSW index, CHECK constraints, upsert idempotence)
      still need a real Postgres; an in-memory provider would pass a suite that proves nothing about them.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <!--
      The in-memory span and metric exporters, for the unit tier only. The telemetry claims worth pinning are
      about what an exported span CARRIES — and, more sharply, what it must never carry (ADR-0019) — so they
      are asserted against real exported activities rather than against the builder that produced them.
    -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.18.0" />
  </ItemGroup>

</Project>
