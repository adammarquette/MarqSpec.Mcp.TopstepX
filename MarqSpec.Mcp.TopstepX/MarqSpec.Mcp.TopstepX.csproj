<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The MCP host: tool registration, both transports, the composition root, and the cache-aside services
    that sit between a tool call and the gateway.

    Sdk.Web rather than Sdk because the streamable-HTTP transport needs the ASP.NET Core framework
    reference (ADR-0007). The stdio path builds the same host and simply never listens.
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="MarqSpec.Mcp.TopstepX.Tests" />
    <InternalsVisibleTo Include="MarqSpec.Mcp.TopstepX.IntegrationTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <RootNamespace>MarqSpec.Mcp.TopstepX</RootNamespace>
    <UserSecretsId>marqspec.mcp.topstepx</UserSecretsId>
    <!-- The container publishes as a non-root user; see the deployment runbook. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <!-- The OAuth mode of the HTTP gate (gh#512). Only the HTTP transport under Mcp__Auth__Mode=OAuth uses it. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="MarqSpec.Client.ProjectX" />

    <!--
      Telemetry (ADR-0019). HERE AND NOWHERE ELSE: the host owns every seam, and instrumentation is a seam.
      `Domain` references nothing at all and `Data` stores what it is handed, so neither gains a package here
      or ever.
    -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <!-- Scheduled tape copy: Parquet files, and Drive only when the operator set a folder and a credential. -->
    <PackageReference Include="Parquet.Net" />
    <PackageReference Include="Google.Apis.Drive.v3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarqSpec.Mcp.TopstepX.Domain\MarqSpec.Mcp.TopstepX.Domain.csproj" />
    <ProjectReference Include="..\MarqSpec.Mcp.TopstepX.Data\MarqSpec.Mcp.TopstepX.Data.csproj" />
  </ItemGroup>

  <!--
    Description attributes are constant expressions, so they cannot call ToString on DefaultMaxRows.
    This writes that constant's invariant spelling and nothing else. A handwritten "5000" would be a
    second cap.
  -->
  <Target Name="GenerateDefaultMaxRowsText" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_MaxRowsSource>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Configuration/MarketDataOptions.cs'))</_MaxRowsSource>
      <_MaxRowsRaw>$([System.Text.RegularExpressions.Regex]::Match($(_MaxRowsSource), 'const int DefaultMaxRows = ([0-9_]+);').Groups[1].Value)</_MaxRowsRaw>
      <_MaxRowsDigits>$([System.Text.RegularExpressions.Regex]::Replace($(_MaxRowsRaw), '_', ''))</_MaxRowsDigits>
      <_MaxRowsGenerated>$(IntermediateOutputPath)DefaultMaxRowsText.g.cs</_MaxRowsGenerated>
    </PropertyGroup>
    <Error
      Condition="'$(_MaxRowsDigits)' == ''"
      Text="DefaultMaxRows was not found in MarketDataOptions.cs, so get_bars cannot name its cap." />
    <ItemGroup>
      <_MaxRowsLine Include="// &lt;auto-generated/&gt;" />
      <_MaxRowsLine Include="// Spelling of MarketDataOptions.DefaultMaxRows for Description attributes." />
      <_MaxRowsLine Include="namespace MarqSpec.Mcp.TopstepX.Configuration%3B" />
      <_MaxRowsLine Include="public sealed partial class MarketDataOptions" />
      <_MaxRowsLine Include="{" />
      <_MaxRowsLine Include="    /// &lt;summary&gt;" />
      <_MaxRowsLine Include="    /// Invariant spelling of &lt;see cref=&quot;DefaultMaxRows&quot;/&gt;, for descriptions." />
      <_MaxRowsLine Include="    /// &lt;/summary&gt;" />
      <_MaxRowsLine Include="    public const string DefaultMaxRowsText = &quot;$(_MaxRowsDigits)&quot;%3B" />
      <_MaxRowsLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_MaxRowsGenerated)" Lines="@(_MaxRowsLine)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(_MaxRowsGenerated)" />
      <FileWrites Include="$(_MaxRowsGenerated)" />
    </ItemGroup>
  </Target>

</Project>
